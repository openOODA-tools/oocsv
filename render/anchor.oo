// # oocsv Render Subsystem Unit Tests
//
// Logline: Verification anchors for terminal visual rendering, table formatting, and JSON serialization.
//
// Setup: Executes themed table formatting passes and JSON structure validations against synthetic CSV datasets.
//
// Beats:
//   1. Verify theme palette resolution and fallback behavior.
//   2. Verify table layout alignment, column dividers, and raw CSV generation.
//   3. Verify JSON serialization of headers, rows, and demo suites.
//   4. Export unified render test harness.

import "core/csv_types.oo";
import "core/csv_demo.oo";
import "render/csv_theme.oo";
import "render/csv_view.oo";
import "render/csv_json.oo";

pub fn test_themes() -> Bool {
    let mono: ThemePalette = get_theme("monochrome");
    if mono.bold != "" {
        return false;
    }
    let def_th: ThemePalette = get_theme("default");
    if chars_len(def_th.bold) == 0 {
        return false;
    }
    return true;
}

pub fn test_views() -> Bool {
    let tbl: CsvTable = build_demo_table();
    let mono: ThemePalette = get_theme("monochrome");

    let table_str: String = render_table_view(tbl, mono);
    if !str_contains(table_str, "hostname") {
        return false;
    }
    if !str_contains(table_str, "node-alpha") {
        return false;
    }

    let raw: String = render_raw_csv(tbl, 44);
    if !str_contains(raw, "hostname,region,role") {
        return false;
    }

    return true;
}

pub fn test_json() -> Bool {
    let tbl: CsvTable = build_demo_filtered_table();
    let hj: String = headers_to_json(tbl);
    if !str_contains(hj, "\"hostname\"") {
        return false;
    }
    if !str_contains(hj, "\"count\": 3") {
        return false;
    }

    let tj: String = table_to_json(tbl);
    if !str_contains(tj, "\"tool\": \"oocsv\"") {
        return false;
    }
    if !str_contains(tj, "\"records\":") {
        return false;
    }
    if !str_contains(tj, "\"node-alpha\"") {
        return false;
    }

    return true;
}

pub fn run_render_tests() -> Bool {
    if !test_themes() {
        return false;
    }
    if !test_views() {
        return false;
    }
    if !test_json() {
        return false;
    }
    return true;
}
